# Server only. Copy to .env.local, enter values, then restart npm run dev.
# FOUNDRY_DOMAIN accepts https://your-enrollment.palantirfoundry.com or the hostname.
# FOUNDRY_MODEL_RID is the RID copied from AIP Model Catalog.
# Select a model compatible with OpenAI Chat Completions and JSON output.
# Example RID: ri.language-model-service..language-model.your-model
# Do not prefix these variables with VITE_ or commit your token.
FOUNDRY_DOMAIN=
FOUNDRY_TOKEN=
FOUNDRY_MODEL_RID=
