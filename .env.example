# Optional server settings. Copy to .env.local only if it does not exist.
# Never prefix credentials with VITE_. Restart the server after changes.

# Jev를 사용하려면 아래 빈칸에 TypeSafe API 키만 입력하고 서버를 재시작하세요.
# 키는 서버에서만 사용합니다. 브라우저 코드나 VITE_ 변수에 넣지 마세요.
# 새 분석은 Codex로 온톨로지를 먼저 설계합니다. Jev 키는 선택 사항입니다.
# 설계 후 매핑 가능한 표 데이터는 로컬에서 변환합니다.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Concurrent Jev requests per process, 1..16. Start with 4.
TYPESAFE_CONCURRENCY=4
# Timeout per request, 1000..120000 ms.
TYPESAFE_TIMEOUT_MS=30000
# Legacy confidence setting, 0.5..1. Generic ontology decisions enforce at least 0.90.
TYPESAFE_MIN_CONFIDENCE=0.85
# Legacy jobs only. New ontology jobs always send uncertain Jev results to Codex.
CLUEVIA_JEV_FALLBACK=true

# Blank uses the installed CLI. Run npm run codex:login first.
# CODEX_BIN is one executable path, not a command with arguments.
CODEX_BIN=
# Model for every stage; global effort for extraction, Jev planning and case chat.
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=xhigh
# Timeout per attempt. One validation repair may run a second attempt.
CODEX_TIMEOUT_MS=180000
# Ontology design only. Blank inherits CODEX_TIMEOUT_MS; extraction stays bounded separately.
CODEX_ONTOLOGY_TIMEOUT_MS=300000

# Persistent SQLite workspace; relative to project root or an absolute path.
CLUEVIA_DATA_DIR=.cluevia
# Seeds the documented GFW historical example once. false starts unseeded.
CLUEVIA_SEED_EXAMPLE=true

# Evidence file size cap in MiB. 0 (default) means no application size cap.
# Large files are streamed to disk, then processed as records or bounded text parts.
# Disk capacity and any reverse proxy upload limits still apply.
CLUEVIA_MAX_UPLOAD_MB=0

# Required for LAN/remote API access. Choose a random key of at least 16 chars.
# Blank allows direct loopback connections only. Enter the key in the web page.
CLUEVIA_ACCESS_TOKEN=

# npm start settings. For LAN use 0.0.0.0 and set an access key.
# npm run dev uses Vite's --host / --port flags instead.
CLUEVIA_HOST=127.0.0.1
PORT=5173

# Model workers across analysis cases (1..8). Persisted commits stay ordered.
CODEX_CONCURRENCY=2
# Concurrent cases (1..4); a large case no longer monopolizes the only job slot.
CLUEVIA_JOB_CONCURRENCY=2
# Stage overrides. Blank: ontology=high, clarification=medium; others use global effort.
CODEX_EXTRACTION_EFFORT=xhigh
CODEX_ONTOLOGY_EFFORT=high
CODEX_CHAT_EFFORT=xhigh
CODEX_CLARIFICATION_EFFORT=medium
# Codex designs declarative Jev rules only for repeated narrative rows with Jev configured.
CODEX_JEV_PLANNING_EFFORT=xhigh
